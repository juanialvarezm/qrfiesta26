# Copiá este archivo como .env y completá los valores.
# En Render se cargan como "Environment Variables" en el panel del servicio.

# Panel privado /admin — usá una contraseña FUERTE (queda expuesto a internet).
ADMIN_USER=admin
ADMIN_PASSWORD=cambiame-por-una-clave-fuerte

# Opcional: URL pública. Si no la ponés, se detecta sola detrás del proxy.
# Ejemplo en Render: https://qr-fiesta.onrender.com
# BASE_URL=

# Opcional: el PaaS define PORT automáticamente. Local usa 3000 por defecto.
# PORT=3000
